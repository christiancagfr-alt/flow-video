{
  "manifest_version": 3,
  "name": "Flow Studio Web Plugin",
  "description": "Flow Studio：后台最小化自愈、按浏览器独立错峰、动态通道、Google任务源同步、持久事件队列；保留原上传/下载核心。支持 Chrome、Edge 和 Firefox 128+。",
  "version": "0.9.67",
  "version_name": "0.9.67 · 读取 Flow 点数 · Chrome / Edge / Firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "flow-studio-web@flowstudio.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "debugger",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "https://flow.google.com/*",
    "https://accounts.google.com/*",
    "http://127.0.0.1/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com/*",
    "https://flow-content.google/*",
    "https://docs.google.com/*",
    "https://drive.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "result-core.js",
        "page-engine.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://accounts.google.com/*"
      ],
      "js": [
        "account-credits.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Flow Studio 0.9.67",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png"],
      "matches": ["https://flow.google.com/*"]
    }
  ]
}
